# Large/regenerable trees: recreated by tools/build-dev.sh
/upstream/
/build/
# Build outputs are checksummed in reports; binaries are not committed
/artifacts/**/*.itb
/artifacts/**/*.ubi
/artifacts/**/*.bin
/artifacts/**/*.tar*
/logs/*.log.full
/board-data/
__pycache__/
*.pyc
/logs/network/.vm-entry.sh
/logs/twin/.helper-entry.sh
# matrix/soak per-run working dirs (bulky regenerated VM logs); summary.tsv is kept
/logs/twin/matrix/*/
/logs/twin/matrix-run.log
/logs/twin/matrix-discrete.log
/logs/nand/.vm-entry.sh
/logs/nand/*.log
/logs/nand/console.txt
/logs/nand/dmesg*.txt
/logs/nand/.vm-entry.sh
/logs/build-dev-resume-*.log
