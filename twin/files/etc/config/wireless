config wifi-device 'radio0'
	option type 'mac80211'
	option path 'virtual/mac80211_hwsim/hwsim0'
	option band '2g'
	option channel '6'
	option htmode 'HE20'
	option country 'DE'
	option cell_density '0'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'AX23-2G'
	option encryption 'psk2+ccmp'
	option key 'twin-test-wpa2'

config wifi-device 'radio1'
	option type 'mac80211'
	option path 'virtual/mac80211_hwsim/hwsim1'
	option band '5g'
	option channel '36'
	option htmode 'HE80'
	option country 'DE'
	option cell_density '0'

config wifi-iface 'default_radio1'
	option device 'radio1'
	option network 'lan'
	option mode 'ap'
	option ssid 'AX23-5G'
	option encryption 'sae'
	option key 'twin-test-wpa3'

# Test-only radios (become Wi-Fi client stations in tests/twin). Declared so
# that wifi auto-detect does not add them; not part of the AX23 model.
config wifi-device 'radio2'
	option type 'mac80211'
	option path 'virtual/mac80211_hwsim/hwsim2'
	option band '2g'
	option country 'DE'
	option disabled '1'

config wifi-device 'radio3'
	option type 'mac80211'
	option path 'virtual/mac80211_hwsim/hwsim3'
	option band '5g'
	option country 'DE'
	option disabled '1'
