From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Julius Bairaktaris <julius@bairaktaris.de>
Date: Fri, 9 Oct 2026 06:46:57 +0200
Subject: [PATCH] qualcommax: pcs: qca-uniphy: clear the mode select for SGMII
 on UNIPHY0

On the PSGMII instance (UNIPHY0 on IPQ8074 and IPQ6018), SGMII and
1000BASE-X run with every mode select bit of UNIPHY_MODE_CTRL clear, as
qca-ssdk's __adpt_hppe_uniphy_sgmii_mode_set() programs it. The driver
sets UNIPHY_SGMII_MODE there instead, and the Zyxel NWA110AX, whose
AR8033 sits on UNIPHY0 channel 0, transmits nothing.

Leave the mode select clear on the instance with a clock pair per
channel, and report 125 MHz for that setting in the clock recalc.
Writing 0x20 or 0x21 to the register on the NWA110AX restores TX.

Closes: https://github.com/openwrt/openwrt/issues/25657
Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
Link: https://github.com/openwrt/openwrt/pull/25750
Signed-off-by: Robert Marko <robimarko@gmail.com>
(cherry picked from commit ee6860ee0fd39857e26b4ced549d1a6bf0c9b2fd)
---
 .../files/drivers/net/pcs/pcs-qca-uniphy.c    | 25 ++++++++++++-------
 1 file changed, 16 insertions(+), 9 deletions(-)

diff --git a/target/linux/qualcommax/files/drivers/net/pcs/pcs-qca-uniphy.c b/target/linux/qualcommax/files/drivers/net/pcs/pcs-qca-uniphy.c
index 80a1040822..91c34c5394 100644
--- a/target/linux/qualcommax/files/drivers/net/pcs/pcs-qca-uniphy.c
+++ b/target/linux/qualcommax/files/drivers/net/pcs/pcs-qca-uniphy.c
@@ -55,15 +55,11 @@ qca_uniphy_clk_recalc_rate(struct clk_hw *hw, unsigned long parent_rate)
 	 * PHY mode.
 	 */
 	regmap_read(uniphy->regmap, UNIPHY_MODE_CTRL, &val);
-	if (val & UNIPHY_SGMII_MODE ||
-	    val & UNIPHY_CH0_PSGMII_QSGMII ||
-	    val & UNIPHY_CH0_QSGMII_SGMII)
-		return 125000000;
-	else if (val & UNIPHY_SGPLUS_MODE ||
-		 val & UNIPHY_XPCS_MODE)
+	if (val & UNIPHY_SGPLUS_MODE ||
+	    val & UNIPHY_XPCS_MODE)
 		return 312500000;
 
-	return 0;
+	return 125000000;
 }
 
 static const struct clk_ops qca_uniphy_clk_ops = {
@@ -462,6 +458,17 @@ static bool uniphy_ch_forced(struct phylink_pcs *pcs, unsigned int neg_mode)
 	       !phylink_expects_phy(pcs->phylink);
 }
 
+/* The PSGMII instance, the only one with a clock pair per channel, runs
+ * SGMII on channel 0 with every mode select bit clear.
+ */
+static u32 uniphy_sgmii_mode(struct qca_uniphy *uniphy)
+{
+	if (uniphy->num_clks == 2 + 2 * QCA_UNIPHY_CHANNELS)
+		return 0;
+
+	return UNIPHY_SGMII_MODE;
+}
+
 static int qca_uniphy_pcs_config_mode(struct phylink_pcs *pcs,
 				      unsigned int neg_mode,
 				      phy_interface_t interface,
@@ -484,11 +491,11 @@ static int qca_uniphy_pcs_config_mode(struct phylink_pcs *pcs,
 	switch (interface) {
 	case PHY_INTERFACE_MODE_1000BASEX:
 		misc2_phy_mode = UNIPHY_MISC2_SGMII;
-		mode_ctrl = UNIPHY_SGMII_MODE;
+		mode_ctrl = uniphy_sgmii_mode(uniphy);
 		break;
 	case PHY_INTERFACE_MODE_SGMII:
 		misc2_phy_mode = UNIPHY_MISC2_SGMII;
-		mode_ctrl = UNIPHY_SGMII_MODE;
+		mode_ctrl = uniphy_sgmii_mode(uniphy);
 		mode_ctrl |= FIELD_PREP(UNIPHY_CH0_MODE_CTRL_25M, UNIPHY_CH0_MODE_MAC);
 		mode_ctrl |= UNIPHY_AUTONEG_MODE_ATH;
 		break;
