# Lightweight core development profile for a 256 MB device.
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
CONFIG_TARGET_qualcommax_ipq50xx_DEVICE_tplink_archer-ax23-v2=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
# Web UI (uhttpd + luci, no SSL-heavy extras)
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=n
# Diagnostics needed by tests/hardware/*.sh on the router
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_tcpdump-mini=y
