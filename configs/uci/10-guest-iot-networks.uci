# SPDX-License-Identifier: GPL-2.0-or-later
# Guest and IoT networks for the AX23 v2 (apply AFTER the base system and
# both radios are validated):   uci batch < 10-guest-iot-networks.uci && uci commit
# Wi-Fi only by default. To also put wired port lan4 into the IoT VLAN see
# 20-wired-vlan-lan4.uci. Addresses must not collide with your upstream.
set network.guest_dev=device
set network.guest_dev.type='bridge'
set network.guest_dev.name='br-guest'
set network.guest_dev.bridge_empty='1'
set network.guest=interface
set network.guest.proto='static'
set network.guest.device='br-guest'
set network.guest.ipaddr='192.168.20.1'
set network.guest.netmask='255.255.255.0'
set network.iot_dev=device
set network.iot_dev.type='bridge'
set network.iot_dev.name='br-iot'
set network.iot_dev.bridge_empty='1'
set network.iot=interface
set network.iot.proto='static'
set network.iot.device='br-iot'
set network.iot.ipaddr='192.168.30.1'
set network.iot.netmask='255.255.255.0'

set dhcp.guest=dhcp
set dhcp.guest.interface='guest'
set dhcp.guest.start='100'
set dhcp.guest.limit='100'
set dhcp.guest.leasetime='1h'
set dhcp.iot=dhcp
set dhcp.iot.interface='iot'
set dhcp.iot.start='100'
set dhcp.iot.limit='100'
set dhcp.iot.leasetime='12h'

# zones: guest -> Internet only; iot -> no Internet, LAN may reach iot
set firewall.guest=zone
set firewall.guest.name='guest'
add_list firewall.guest.network='guest'
set firewall.guest.input='REJECT'
set firewall.guest.output='ACCEPT'
set firewall.guest.forward='REJECT'
set firewall.guest_wan=forwarding
set firewall.guest_wan.src='guest'
set firewall.guest_wan.dest='wan'
set firewall.iot=zone
set firewall.iot.name='iot'
add_list firewall.iot.network='iot'
set firewall.iot.input='REJECT'
set firewall.iot.output='ACCEPT'
set firewall.iot.forward='REJECT'
set firewall.lan_iot=forwarding
set firewall.lan_iot.src='lan'
set firewall.lan_iot.dest='iot'
add firewall rule
set firewall.@rule[-1].name='Guest-DHCP-DNS'
set firewall.@rule[-1].src='guest'
set firewall.@rule[-1].dest_port='53 67'
set firewall.@rule[-1].target='ACCEPT'
add firewall rule
set firewall.@rule[-1].name='IoT-DHCP-DNS'
set firewall.@rule[-1].src='iot'
set firewall.@rule[-1].dest_port='53 67'
set firewall.@rule[-1].target='ACCEPT'

# SSIDs (radio names as generated by OpenWrt; check `uci show wireless`)
set wireless.guest_2g=wifi-iface
set wireless.guest_2g.device='radio0'
set wireless.guest_2g.mode='ap'
set wireless.guest_2g.network='guest'
set wireless.guest_2g.ssid='CHANGE-ME-guest'
set wireless.guest_2g.encryption='sae-mixed'
set wireless.guest_2g.key='CHANGE-ME-guest-passphrase'
set wireless.guest_2g.isolate='1'
set wireless.iot_2g=wifi-iface
set wireless.iot_2g.device='radio0'
set wireless.iot_2g.mode='ap'
set wireless.iot_2g.network='iot'
set wireless.iot_2g.ssid='CHANGE-ME-iot'
# many IoT devices are WPA2-only
set wireless.iot_2g.encryption='psk2+ccmp'
set wireless.iot_2g.key='CHANGE-ME-iot-passphrase'
